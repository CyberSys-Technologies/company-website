# Copy to .env.local for local builds; set the same names in Vercel → Project → Settings → Environment Variables.

# Cloudflare Turnstile (contact form bot check) — https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=        # public site key, served to the page by GET /api/contact
TURNSTILE_SECRET_KEY=      # secret key, server only (api/contact.ts)

# Resend (sends the contact form email) — https://resend.com, verify cybersystechnologies.com first
RESEND_API_KEY=
CONTACT_FROM="CyberSys Website <website@cybersystechnologies.com>"
CONTACT_TO=info@cybersystechnologies.com

# Optional: extra comma-separated origins allowed to post the form (e.g. a Vercel preview URL)
ALLOWED_ORIGINS=
